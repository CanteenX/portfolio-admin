{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@admin-platform/shared-types": ["./src/shared/types/index.ts"],
      "@admin-platform/shared-sdk": ["./src/shared/sdk/index.ts"],
      "@admin-platform/shared-rbac": ["./src/shared/rbac/index.ts"]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
